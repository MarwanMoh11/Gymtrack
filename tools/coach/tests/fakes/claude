#!/usr/bin/env python3
"""A stand-in for the claude binary, for the tests.

`--help` lists the flags the real one does. Any other call records what the
child was given (arguments, working directory, the session markers it can see,
the prompt) to FAKE_CLAUDE_LOG and answers with the next entry of
FAKE_CLAUDE_REPLIES: a JSON list whose items are an object (sent as the reply
text) or a plain string (sent as it is, for the garbage cases).
"""
import json
import os
import sys

HELP = """Usage: claude [options]
  -p, --print    Print response and exit
  --output-format <format>
  --tools <tools...>
  --no-session-persistence
  --disable-slash-commands
  --strict-mcp-config
  --system-prompt <prompt>
  --setting-sources <sources>
  --model <model>
  --effort <level>
"""

if "--help" in sys.argv:
    print(HELP)
    sys.exit(0)

prompt = sys.stdin.read()
log = os.environ["FAKE_CLAUDE_LOG"]
calls = 0
if os.path.exists(log):
    calls = len(open(log).read().splitlines())
with open(log, "a") as handle:
    handle.write(json.dumps({
        "argv": sys.argv[1:], "cwd": os.getcwd(), "prompt": prompt,
        "claudecode": os.environ.get("CLAUDECODE"), "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID"),
        "oauth": os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"), "disable_mds": os.environ.get("CLAUDE_CODE_DISABLE_CLAUDE_MDS"),
    }) + "\n")
replies = json.load(open(os.environ["FAKE_CLAUDE_REPLIES"]))
reply = replies[calls]
if os.environ.get("FAKE_CLAUDE_EXIT"):
    print("boom", file=sys.stderr)
    sys.exit(int(os.environ["FAKE_CLAUDE_EXIT"]))
text = reply if isinstance(reply, str) else json.dumps(reply)
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": text,
                  "duration_ms": 12, "total_cost_usd": 0.01, "num_turns": 1}))
